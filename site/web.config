<?xml version="1.0" encoding="utf-8"?>
<!--
  sigetec.cl — configuración para IIS (Windows). Equivale al .htaccess de Apache.
  El sitio es estático; el único parámetro que se edita en el servidor es config/site-config.js
  (ID de Google Analytics). El valor de appSettings de más abajo queda como referencia documentada
  y para scripts de despliegue; el navegador lee config/site-config.js.
-->
<configuration>
  <appSettings>
    <!-- Google Tag Manager y GA4. Mantener igual que config/site-config.js (es el que lee el navegador) -->
    <add key="GoogleTagManagerId" value="GTM-T2DL422P" />
    <add key="GoogleAnalyticsId" value="" />
    <!-- Consentimiento de cookies (v2.4): ver config/site-config.js -->
    <add key="ConsentVersion" value="2026-11-08" />
    <add key="ConsentLogUrl" value="/api/consentimiento.php" />
    <add key="SiteUrl" value="https://sigetec.cl" />
    <add key="ContactEmail" value="contacto@sigetec.cl" />
  </appSettings>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".pf_index" />
      <mimeMap fileExtension=".pf_index" mimeType="application/octet-stream" />
      <remove fileExtension=".pf_fragment" />
      <mimeMap fileExtension=".pf_fragment" mimeType="application/octet-stream" />
      <remove fileExtension=".pf_meta" />
      <mimeMap fileExtension=".pf_meta" mimeType="application/octet-stream" />
      <remove fileExtension=".pagefind" />
      <mimeMap fileExtension=".pagefind" mimeType="application/octet-stream" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <rule name="Forzar HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Formulario de contacto" stopProcessing="true">
          <match url="^api/contacto/?$" />
          <action type="Rewrite" url="api/contacto.php" appendQueryString="true" />
        </rule>
        <rule name="Redirecciones del sitio anterior: blog" stopProcessing="true">
          <match url="^(blog|category/.*)/?$" />
          <action type="Redirect" url="/casos/" redirectType="Permanent" />
        </rule>
        <rule name="Redirecciones del sitio anterior: tienda" stopProcessing="true">
          <match url="^(tienda|shop)(/.*)?$" />
          <action type="Redirect" url="/productos/" redirectType="Permanent" />
        </rule>
        <rule name="Redirección contacto-2" stopProcessing="true">
          <match url="^contacto-2/?$" />
          <action type="Redirect" url="/contacto/" redirectType="Permanent" />
        </rule>
        <rule name="Redirección quienes-somos" stopProcessing="true">
          <match url="^quienes-somos/?$" />
          <action type="Redirect" url="/nosotros/" redirectType="Permanent" />
        </rule>
        <rule name="Redirección servicios" stopProcessing="true">
          <match url="^servicios/?$" />
          <action type="Redirect" url="/soluciones/" redirectType="Permanent" />
        </rule>
        <rule name="Barra final en carpetas" stopProcessing="true">
          <match url="^(.*[^/])$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Redirect" url="{R:1}/" redirectType="Permanent" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Parámetros sin caché larga" preCondition="EsSiteConfig">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=300" />
        </rule>
        <preConditions>
          <preCondition name="EsSiteConfig">
            <add input="{REQUEST_URI}" pattern="/config/site-config\.js$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="config.php" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
